    "vitest": "^4.1.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "browser": {
    "crypto": false
  },
  "scripts": {
    "start": "vite",
    "dev": "vite --debug",
    "preview": "vite preview",
    "build": "tsc && vite build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "cypress run",
    "test:e2e:offline-math": "cypress run --config-file cypress.offline.config.ts",
    "test:bundle-budget": "bun test scripts/check-bundle-budget.test.mjs",
    "cypress": "cypress open",
    "typecheck": "tsc --noEmit",
    "typecheck:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "tui": "bun run src/tui/index.tsx",
    "tui:build": "bun scripts/build-tui.ts",
    "tui:install": "bun scripts/install-tui.ts",
    "lint": "bunx --no-install biome ci src cypress *.config.ts",
    "lint:fix": "biome check --write src/ *.config.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
